<Page
    x:Class="FreshRssClient.Views.ArticlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:FreshRssClient.Services"
    xmlns:views="using:FreshRssClient.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Tint drawn over the card on pointer/selection states; per-state strength comes from the overlay opacity -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardStateOverlayBrush" Color="#000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardStateOverlayBrush" Color="#FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <views:StringToImageSourceConverter x:Key="ImageConverter"/>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"/>
                                <Border x:Name="PointerOverOverlay"
                                        Background="{ThemeResource ButtonBackgroundPointerOver}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="PressedOverlay"
                                        Background="{ThemeResource ButtonBackgroundPressed}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PointerOverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083"/>
                                                <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PointerOverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083"/>
                                                <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PointerOverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PointerOverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/>
                                                <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Card container: retemplated because ListViewItemPresenter ignores CornerRadius,
                 which left the state visuals square against the rounded card -->
            <Style x:Key="ArticleCardContainerStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="6"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <!-- Border (not Grid) is the root: it clips its children to the corner radius -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.11" Duration="0:0:0.08">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualState x:Name="Unselected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionOverlay" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="SelectedUnfocused">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionOverlay" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                              <Grid>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <!-- Separate overlays so hover and selection stack instead of overwriting each other -->
                                <Border x:Name="SelectionOverlay"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardStateOverlayBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="HoverOverlay"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardStateOverlayBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                              </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        <!-- Right-click Context Menu Resource -->
        <MenuFlyout x:Key="ArticleContextFlyout" Opening="OnArticleContextFlyoutOpening">
            <MenuFlyoutItem x:Name="ContextToggleReadItem" Click="OnContextToggleReadClicked">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Read"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="ContextOpenBrowserItem" Click="OnContextOpenInBrowserClicked">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Globe"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="ContextSelectItem" Click="OnContextSelectClicked">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="SelectAll"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- ListView Item Template -->
        <DataTemplate x:Key="ArticleListTemplate" x:DataType="services:RssArticle">
            <Grid Padding="12,10" ContextFlyout="{StaticResource ArticleContextFlyout}" PointerPressed="OnItemPointerPressed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Selection CheckBox -->
                <CheckBox Grid.Row="0" Grid.Column="0"
                          AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                          MinWidth="0" MinHeight="0"
                          Width="24" Height="24"
                          Padding="0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="-4,0,0,0"
                          Opacity="0.85"/>

                <!-- Left Column: Content -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="20,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Feed Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Source="{x:Bind FeedIconUrl, Converter={StaticResource ImageConverter}, Mode=OneWay}" Width="16" Height="16" Stretch="UniformToFill" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind FeedTitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                Command="{x:Bind MarkAsReadCommand, Mode=OneWay}"
                                Visibility="{x:Bind MarkAsReadVisibility, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8FB;" FontSize="12" FontFamily="Segoe Fluent Icons"/>
                        </Button>
                    </Grid>

                    <!-- Title -->
                    <TextBlock Grid.Row="1" 
                               Text="{x:Bind Title, Mode=OneWay}" 
                               FontSize="14" 
                               FontWeight="{x:Bind TitleFontWeight, Mode=OneWay}" 
                               Opacity="{x:Bind TitleOpacity, Mode=OneWay}"
                               TextWrapping="Wrap" 
                               MaxLines="2"/>

                    <!-- Date -->
                    <TextBlock Grid.Row="2" 
                               Text="{x:Bind PublishDate, Mode=OneWay}" 
                               FontSize="11" 
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                               Margin="0,4,0,0"/>
                </Grid>

                <!-- Right Column: Image (if any) -->
                <Border Grid.Row="0" Grid.Column="1" 
                        Width="60" 
                        Height="60" 
                        CornerRadius="6" 
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ImageVisibility, Mode=OneWay}">
                    <Image Source="{x:Bind ImageUrl, Converter={StaticResource ImageConverter}, Mode=OneWay}" Stretch="UniformToFill" Width="60" Height="60"/>
                </Border>

                <!-- Bottom Separator -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                        Height="1" 
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                        BorderThickness="0,0,0,1" 
                        Margin="12,4,12,0"/>
            </Grid>
        </DataTemplate>

        <!-- GridView Item Template -->
        <DataTemplate x:Key="ArticleGridTemplate" x:DataType="services:RssArticle">
            <Border Width="260" Height="280" Margin="0"
                    Background="Transparent"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1"
                    ContextFlyout="{StaticResource ArticleContextFlyout}"
                    PointerPressed="OnItemPointerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Image / Header Area -->
                    <Grid Grid.Row="0" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="8,8,0,0">
                        <SymbolIcon Symbol="Document" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{x:Bind ImageUrl, Converter={StaticResource ImageConverter}, Mode=OneWay}" Stretch="UniformToFill" Width="260" Height="120" AutomationProperties.AccessibilityView="Raw"/>
                        
                        <!-- Selection CheckBox -->
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                  MinWidth="0" MinHeight="0"
                                  Width="24" Height="24"
                                  Padding="0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="8"
                                  Opacity="0.85"/>

                        <Button Command="{x:Bind MarkAsReadCommand, Mode=OneWay}"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                Visibility="{x:Bind MarkAsReadVisibility, Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="8"
                                Opacity="0.7">
                            <FontIcon Glyph="&#xE8FB;" FontSize="12" FontFamily="Segoe Fluent Icons"/>
                        </Button>
                    </Grid>

                    <!-- Details Area -->
                    <Grid Grid.Row="1" Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Source Feed -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                            <Image Source="{x:Bind FeedIconUrl, Converter={StaticResource ImageConverter}, Mode=OneWay}" Width="14" Height="14" Stretch="UniformToFill" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind FeedTitle, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" 
                                   Text="{x:Bind Title, Mode=OneWay}" 
                                   FontSize="13" 
                                   FontWeight="{x:Bind TitleFontWeight, Mode=OneWay}" 
                                   Opacity="{x:Bind TitleOpacity, Mode=OneWay}"
                                   TextWrapping="Wrap" 
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis" 
                                   Margin="0,0,0,4"/>

                        <!-- Summary -->
                        <TextBlock Grid.Row="2" 
                                   Text="{x:Bind Summary, Mode=OneWay}" 
                                   FontSize="11" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis" 
                                   Opacity="0.85"/>

                        <!-- Date -->
                        <TextBlock Grid.Row="3" 
                                   Text="{x:Bind PublishDate, Mode=OneWay}" 
                                   FontSize="10" 
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="OnRootGridSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumnDefinition" Width="350"/>
            <ColumnDefinition x:Name="RightColumnDefinition" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Divider Border -->
        <Border x:Name="VerticalDivider" Grid.Column="0" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,0,1,0" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Stretch"/>

        <!-- Column 0: Articles List/Grid -->
        <Grid x:Name="LeftGrid" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Top Header bar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: ProgressRing -->
                <RowDefinition Height="*"/>    <!-- Row 2: ListView / GridView -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Mass Action Bar -->
                <RowDefinition Height="32"/>   <!-- Row 4: Bottom Status bar -->
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Grid Grid.Row="0" Padding="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>

                <Button x:Name="FilterBtn" Grid.Column="1" 
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.AutomationId="ArticlesFilterButton"
                        Background="Transparent" 
                        BorderThickness="0" 
                        VerticalAlignment="Center" 
                        Width="32"
                        Height="32"
                        Padding="0" 
                        Margin="0,0,6,0">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" FontFamily="Segoe Fluent Icons"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="FilterMenu">
                            <RadioMenuFlyoutItem x:Name="ShowUnreadItem" GroupName="ArticleFilterGroup" Click="OnFilterUnreadClicked"/>
                            <RadioMenuFlyoutItem x:Name="ShowReadItem" GroupName="ArticleFilterGroup" Click="OnFilterReadClicked"/>
                            <RadioMenuFlyoutItem x:Name="ShowAllItem" GroupName="ArticleFilterGroup" Click="OnFilterAllClicked"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="SelectAllBtn" Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.AutomationId="ArticlesSelectAllButton"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="0,0,6,0"
                        Click="OnSelectAllClicked">
                    <FontIcon Glyph="&#xE762;" FontSize="14" FontFamily="Segoe Fluent Icons"/>
                </Button>

                <Button x:Name="LayoutBtn" Grid.Column="3" 
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.AutomationId="ArticlesLayoutButton"
                        Background="Transparent" 
                        BorderThickness="0" 
                        VerticalAlignment="Center" 
                        Width="32"
                        Height="32"
                        Padding="0" 
                        Margin="0,0,6,0"
                        Click="OnLayoutClicked">
                    <FontIcon x:Name="LayoutBtnIcon" Glyph="&#xE80A;" FontSize="14" FontFamily="Segoe Fluent Icons"/>
                </Button>

                <Button x:Name="RefreshBtn" Grid.Column="4" 
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.AutomationId="ArticlesRefreshButton"
                        Background="Transparent" 
                        BorderThickness="0" 
                        VerticalAlignment="Center" 
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="0,0,6,0">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" FontFamily="Segoe Fluent Icons"/>
                </Button>
            </Grid>

            <!-- Premium Indeterminate ProgressBar -->
            <ProgressBar x:Name="ProgressIndicator" Grid.Row="1" 
                         IsIndeterminate="True" 
                         Height="3" 
                         Margin="0,0,0,4"
                         Visibility="Collapsed"/>

            <!-- ListView (Split Layout) -->
            <ListView x:Name="ArticlesListView" Grid.Row="2" 
                      AutomationProperties.AutomationId="ArticlesList"
                      SelectionMode="Extended" 
                      Margin="0"
                      ItemTemplate="{StaticResource ArticleListTemplate}"
                      SelectionChanged="OnArticlesListViewSelectionChanged"/>

            <!-- GridView (Grid Layout) -->
            <GridView x:Name="ArticlesGridView" Grid.Row="2" 
                      AutomationProperties.AutomationId="ArticlesGrid"
                      SelectionMode="Extended" 
                      Margin="12" 
                      Padding="0"
                      ItemTemplate="{StaticResource ArticleGridTemplate}"
                      ItemContainerStyle="{StaticResource ArticleCardContainerStyle}"
                      Visibility="Collapsed"
                      SelectionChanged="OnArticlesGridViewSelectionChanged"/>

            <!-- Empty State View -->
            <Grid x:Name="EmptyStateView" Grid.Row="2" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE930;" FontSize="28" Foreground="{ThemeResource SystemAccentColorBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons"/>
                    </Border>
                    <TextBlock x:Name="EmptyStateHeader" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="EmptyStateSubtitle" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="250" TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Mass Action Bar -->
            <Grid x:Name="MassMenuBar" Grid.Row="3" 
                  Padding="12,8,12,8" 
                  Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
                  Visibility="Collapsed" 
                  BorderThickness="0,1,0,1" 
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectedCountText" Grid.Column="0" 
                           VerticalAlignment="Center" 
                           FontSize="13" 
                           FontWeight="Medium"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="MassMarkReadBtn" Click="OnMassMarkReadClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8FB;" FontSize="12" FontFamily="Segoe Fluent Icons"/>
                            <TextBlock x:Name="MassMarkReadText"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MassOpenBtn" Click="OnMassOpenClicked"
                            Background="{ThemeResource SystemAccentColorBrush}" 
                            Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71B;" FontSize="12" FontFamily="Segoe Fluent Icons"/>
                            <TextBlock x:Name="MassOpenText"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Sync Status bottom bar -->
            <Grid Grid.Row="4" Padding="12,0,12,0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <TextBlock x:Name="SyncStatusText" VerticalAlignment="Center" 
                           FontSize="11" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>

        <!-- Column 1: Article Content Viewer -->
        <ScrollViewer x:Name="RightScroll" Grid.Column="1" Padding="24" Visibility="Collapsed">
            <StackPanel Spacing="16">

                <!-- Image Header -->
                <Border x:Name="ArticleImageBorder" CornerRadius="8" HorizontalAlignment="Left">
                    <Image x:Name="ArticleImage" Height="220" Stretch="UniformToFill" HorizontalAlignment="Left"/>
                </Border>

                <!-- Title -->
                <TextBlock x:Name="DetailTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>

                <!-- Metadata Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Image x:Name="DetailFeedIcon" Width="16" Height="16" Stretch="UniformToFill" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="FeedMeta" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="DateMeta" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <!-- Separator -->
                <Border Height="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"/>

                <!-- Content Body -->
                <TextBlock x:Name="BodyText" FontSize="15" TextWrapping="Wrap" LineHeight="22"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                    <Button x:Name="OpenBrowserButton" Click="OnOpenInBrowserClicked"
                            AutomationProperties.AutomationId="OpenArticleInBrowserButton"
                            Background="{ThemeResource SystemAccentColorBrush}" 
                            Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Column 1: Article Content Viewer Frame (for Grid Layout page transitions) -->
        <Frame x:Name="DetailFrame" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
</Page>
